# URL base del gateway de Foodly (Kong). Todas las llamadas a IAM salen de aquí.
# Copia este archivo a .env.local y ajusta el valor. NEXT_PUBLIC_* se incrusta al compilar:
# reinicia `npm run dev` o vuelve a ejecutar `npm run build` tras cambiarlo.
# Es público (va en el navegador): nunca pongas secretos aquí.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# URL de la Web App de Foodly (Foodly-WebApp). "Iniciar sesión" y "Explorar platos" apuntan aquí.
# Es pública (se incrusta al compilar). Por defecto: http://localhost:5173
NEXT_PUBLIC_WEBAPP_URL=http://localhost:5173
